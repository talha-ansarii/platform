// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql" // or whichever database you are using
}

enum Role {
  ADMIN
  PERFORMER
  CLIENT
} 

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

enum NotificationType {
  NEW_REQUEST
  REQUEST_APPROVED
  REQUEST_REJECTED
  NEW_MESSAGE
  EVENT_ASSIGNED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  profileImage String?  @map("profile_image")
  isVerified   Boolean  @default(false) @map("is_verified")
  isBlocked    Boolean  @default(false) @map("is_blocked")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  performer               Performer?
  client                  Client?
  conversationParticipant ConversationParticipant[]
  messagesSent            Message[]
  reviewsGiven            Review[]
  notifications           Notification[]
  supportTickets          SupportTicket[]
  adminActionsPerformed   AdminAction[]             @relation("AdminUser")
  adminActionsReceived    AdminAction[]             @relation("TargetUser")

  @@map("users")
}

model Performer {
  userId        String   @id @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  designation   String?
  location      String?
  averageRating Decimal? @map("average_rating")
  totalReviews  Int      @default(0) @map("total_reviews")
  isPublic      Boolean  @default(true) @map("is_public")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  socialLinks PerformerSocialLink[]
  genres      PerformerGenre[]
  requests    EventRequest[]
  assignments PerformerAssignment[]
  reviews     Review[]

  @@map("performers")
}

model Client {
  userId      String   @id @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String   @map("company_name")
  industry    String?
  description String?
  website     String?
  location    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  events          Event[]
  assignmentsMade PerformerAssignment[]

  @@map("clients")
}

model SocialPlatform {
  id   String @id @default(uuid())
  name String @unique

  // Relationships
  performerLinks PerformerSocialLink[]

  @@map("social_platforms")
}

model PerformerSocialLink {
  id               String   @id @default(uuid())
  performerUserId  String   @map("performer_user_id")
  socialPlatformId String   @map("social_platform_id")
  profileUrl       String   @map("profile_url")
  createdAt        DateTime @default(now()) @map("created_at")

  performer      Performer      @relation(fields: [performerUserId], references: [userId], onDelete: Cascade)
  socialPlatform SocialPlatform @relation(fields: [socialPlatformId], references: [id], onDelete: Cascade)

  @@map("performer_social_links")
}

model Genre {
  id   String @id @default(uuid())
  name String @unique

  // Relationships
  performers PerformerGenre[]

  @@map("genres")
}

model PerformerGenre {
  performerUserId String @map("performer_user_id")
  genreId         String @map("genre_id")

  performer Performer @relation(fields: [performerUserId], references: [userId], onDelete: Cascade)
  genre     Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([performerUserId, genreId])
  @@map("performer_genres")
}

model Event {
  id            String      @id @default(uuid())
  clientUserId  String      @map("client_user_id")
  title         String
  description   String?
  eventType     String?     @map("event_type")
  location      String?
  budget        Decimal?
  startDatetime DateTime?   @map("start_datetime")
  endDatetime   DateTime?   @map("end_datetime")
  status        EventStatus @default(DRAFT)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  client      Client                @relation(fields: [clientUserId], references: [userId], onDelete: Cascade)
  requests    EventRequest[]
  assignments PerformerAssignment[]
  reviews     Review[]

  @@map("events")
}

model EventRequest {
  id              String        @id @default(uuid())
  eventId         String        @map("event_id")
  performerUserId String        @map("performer_user_id")
  message         String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  performer Performer @relation(fields: [performerUserId], references: [userId], onDelete: Cascade)

  @@unique([eventId, performerUserId])
  @@map("event_requests")
}

model PerformerAssignment {
  id                 String           @id @default(uuid())
  eventId            String           @map("event_id")
  performerUserId    String           @map("performer_user_id")
  assignedByClientId String           @map("assigned_by_client_id")
  status             AssignmentStatus @default(ACTIVE)
  assignedAt         DateTime         @default(now()) @map("assigned_at")

  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  performer  Performer @relation(fields: [performerUserId], references: [userId], onDelete: Cascade)
  assignedBy Client    @relation(fields: [assignedByClientId], references: [userId], onDelete: Cascade)

  @@unique([eventId, performerUserId])
  @@map("performer_assignments")
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  type           MessageType @default(TEXT)
  content        String
  isRead         Boolean     @default(false) @map("is_read")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Review {
  id              String   @id @default(uuid())
  eventId         String   @map("event_id")
  reviewerUserId  String   @map("reviewer_user_id")
  performerUserId String   @map("performer_user_id")
  rating          Int
  reviewText      String?  @map("review_text")
  createdAt       DateTime @default(now()) @map("created_at")

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewer  User      @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)
  performer Performer @relation(fields: [performerUserId], references: [userId], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SupportTicket {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model AdminAction {
  id           String   @id @default(uuid())
  adminUserId  String   @map("admin_user_id")
  targetUserId String   @map("target_user_id")
  actionType   String   @map("action_type")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  adminUser  User @relation("AdminUser", fields: [adminUserId], references: [id])
  targetUser User @relation("TargetUser", fields: [targetUserId], references: [id])

  @@map("admin_actions")
}
